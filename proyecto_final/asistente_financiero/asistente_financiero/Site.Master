<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="asistente_financiero.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Asistente Financiero</title>
    <link rel="icon" href="/Images/favicon.ico" type="image/x-icon" />
    <link rel="shortcut icon" href="/Images/favicon.ico" type="image/x-icon" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>

<form id="form1" runat="server">

    <!-- MENÚ -->
    <div style="background-color:#E8FBFF; padding:10px; display:flex; align-items:center;">
    
         <!-- Logo -->
         <a href="Default.aspx">
            <img src="Images/logo.png" alt="Logo" style="height:40px; margin-right:20px;" />
        </a>


         <!-- Menú -->
         <a href="Default.aspx" style="color:blue; margin-right:15px; text-decoration:none;">Dashboard</a>
         <a href="Ingresos.aspx" style="color:blue; margin-right:15px; text-decoration:none;">Ingresos</a>
         <a href="Gastos.aspx" style="color:blue; margin-right:15px; text-decoration:none;">Gastos</a>
         <a href="Deudas.aspx" style="color:blue; text-decoration:none;">Deudas</a>

    </div>


    <!-- CONTENIDO -->
    <div style="padding:20px;">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </div>

</form>

</body>
</html>
