<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="SiteMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <title>Asistente Financiero - <%: Page.Title %></title>
    
    <style>
        /* ESTILOS COMPLETOS QUE TE ENVIÉ ANTES */
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI'; }
        body { background-color: #f5f7fa; color: #333; }
        .master-header { background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%); color: white; padding: 0; }
        .header-container { width: 90%; max-width: 1200px; margin: 0 auto; padding: 0 15px; display: flex; justify-content: space-between; align-items: center; }
        .logo-area { display: flex; align-items: center; padding: 15px 0; }
        .logo-text { font-size: 24px; font-weight: 700; color: white; text-decoration: none; }
        .logo-subtext { font-size: 12px; color: #bdc3c7; margin-top: 2px; display: block; }
        .nav-menu { list-style: none; display: flex; gap: 5px; }
        .nav-link { color: white; text-decoration: none; padding: 12px 18px; display: flex; align-items: center; border-radius: 4px; transition: all 0.3s; }
        .nav-link:hover { background-color: rgba(255,255,255,0.15); }
        .content-container { width: 90%; max-width: 1200px; margin: 0 auto; padding: 0 15px; }
        .master-footer { background-color: #2c3e50; color: white; padding: 25px 0; margin-top: 40px; border-top: 3px solid #3498db; }
        .page-title { color: #2c3e50; margin-bottom: 25px; padding-bottom: 15px; border-bottom: 2px solid #3498db; }
        .card { background: white; border-radius: 8px; padding: 20px; margin-bottom: 20px; box-shadow: 0 3px 10px rgba(0,0,0,0.08); }
        .btn { padding: 10px 20px; background-color: #3498db; color: white; border: none; border-radius: 4px; cursor: pointer; }
        .form-control { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 4px; }
        .data-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .data-table th { background-color: #2c3e50; color: white; padding: 15px; }
        .data-table td { padding: 12px 15px; border-bottom: 1px solid #eee; }
    </style>
    
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- HEADER -->
        <header class="master-header">
            <div class="header-container">
                <div class="logo-area">
                    <a href="~/Default.aspx" class="logo-text" runat="server">
                        💰 Asistente Financiero
                        <span class="logo-subtext">Gestión Inteligente de Deudas</span>
                    </a>
                </div>
                
                <nav class="main-navigation">
                    <ul class="nav-menu">
                        <li><a href="~/Default.aspx" class="nav-link" runat="server" id="lnkHome">🏠 Inicio</a></li>
                        <li><a href="~/Pages/Dashboard.aspx" class="nav-link" runat="server" id="lnkDashboard">📊 Dashboard</a></li>
                        <li><a href="~/Pages/Deudas.aspx" class="nav-link" runat="server" id="lnkDeudas">📋 Deudas</a></li>
                        <li><a href="~/Pages/Proyecciones.aspx" class="nav-link" runat="server" id="lnkProyecciones">📅 Proyecciones</a></li>
                        <li><a href="~/Pages/Reportes.aspx" class="nav-link" runat="server" id="lnkReportes">📈 Reportes</a></li>
                    </ul>
                </nav>
            </div>
        </header>
        
        <!-- CONTENIDO -->
        <main class="main-content-wrapper">
            <div class="content-container">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </main>
        
        <!-- FOOTER -->
        <footer class="master-footer">
            <div class="footer-container">
                <p><strong>Asistente Financiero</strong> - Proyecto Final</p>
                <p>&copy; <%: DateTime.Now.Year %> Sistema de Gestión de Deudas</p>
            </div>
        </footer>
    </form>
</body>
</html>